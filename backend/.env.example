# DeepSeek
DEEPSEEK_API_KEY=""

# Public URL used by payment gateways to return users and send webhooks.
# Localhost cannot receive Hupijiao's notify_url; use your production domain or a tunnel URL.
PUBLIC_BASE_URL="https://your-domain.example"

# Hupijiao / XunhuPay
HUPIJIAO_APPID=""
HUPIJIAO_APPSECRET=""
HUPIJIAO_GATEWAY_URL="https://api.xunhupay.com/payment/do.html"

# Optional overrides. Leave blank to derive from PUBLIC_BASE_URL.
HUPIJIAO_NOTIFY_URL=""
HUPIJIAO_RETURN_URL=""
HUPIJIAO_CALLBACK_URL=""

# Optional local-only manual payment callback token.
DEV_PAYMENT_CALLBACK_TOKEN=""

# Email verification codes for registration and password reset.
# Local development can set EMAIL_CODE_DEBUG=1 to return debug_code in API response.
EMAIL_CODE_DEBUG="0"
EMAIL_CODE_SECRET=""
EMAIL_CODE_EXPIRE_SECONDS="600"
EMAIL_CODE_COOLDOWN_SECONDS="60"
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_SSL="1"

# Optional yt-dlp cookies file for sites that require login verification, especially YouTube.
# Use a Netscape-format cookies.txt exported from a trusted browser session.
YTDLP_COOKIES_FILE=""
